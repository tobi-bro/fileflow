# FileFlow Environment Configuration
# Server Configuration
FILEFLOW_HOST=127.0.0.1
FILEFLOW_PORT=8000
FILEFLOW_DEBUG=false

# Allowed Storage Directories (comma-separated, empty allows user-selected standard paths)
FILEFLOW_ALLOWED_PATHS=

# Logging
FILEFLOW_LOG_LEVEL=INFO
FILEFLOW_LOG_FILE=logs/fileflow.log

# Database
FILEFLOW_DB_PATH=data/fileflow.db
